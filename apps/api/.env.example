# Only APP_NAME and CORS_ORIGINS are consumed by the health scaffold today.
APP_NAME=FilingGuard AI
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Configuration contract for the modules to be implemented.
DATABASE_URL=postgresql+psycopg://filingguard:local_dev_only@localhost:5432/filingguard
COURTLISTENER_API_TOKEN=
LLM_PROVIDER=groq
GROQ_API_KEY=
# Set an available structured-output model after evaluating the demo cases.
GROQ_MODEL=
ANALYSIS_MODE=live
MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=20
MAX_DOCUMENT_CHARACTERS=100000
MAX_UNIQUE_AUTHORITIES=25
MAX_CONCURRENT_ANALYSES=1
PROVIDER_TIMEOUT_SECONDS=20
ANALYSIS_TIMEOUT_SECONDS=90
PRIVATE_STORAGE_DIR=.runtime
RETENTION_HOURS=24
