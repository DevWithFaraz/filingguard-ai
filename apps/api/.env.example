# Shell settings; document intake remains disabled.
APP_NAME=FilingGuard AI
INTAKE_ENABLED=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CLEANUP_INTERVAL_SECONDS=60
# Optional absolute, dedicated private directory; parent must already exist.
# Configure only after applying migrations to the intended database.
# PRIVATE_STORAGE_DIRECTORY=C:/absolute/private/filingguard-storage

# Implemented runtime configuration; credentials stay private.
DATABASE_URL=postgresql+psycopg://filingguard:local_dev_only@localhost:5432/filingguard
COURTLISTENER_API_TOKEN=
# Explicit opt-in: provider stages execute in contained workers with private IPC credentials.
SOURCE_VERIFICATION_ENABLED=false
SEMANTIC_REVIEW_ENABLED=false
GROQ_API_KEY=
# Selected model verified on the curated synthetic fixture; expert real-case review remains.
GROQ_MODEL=openai/gpt-oss-120b
ANALYSIS_TIMEOUT_SECONDS=90
REVIEW_STAGE_TIMEOUT_SECONDS=30
# The explicitly enabled curated live acceptance uses 60, within the overall 90.
# Keep provider opt-ins off until deployment gates and credentials are verified.
MAX_PROVIDER_ATTEMPTS=60
# Fixed implementation limits are documented in README; they are not env switches.
