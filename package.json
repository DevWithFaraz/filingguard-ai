{
  "name": "filingguard-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/web"],
  "engines": { "node": ">=24 <25", "npm": ">=10" },
  "scripts": {
    "setup:api": "node scripts/api.mjs sync --locked",
    "dev:api": "node scripts/api.mjs run uvicorn filingguard.main:app --reload --host 127.0.0.1 --port 8000",
    "typecheck": "npm run typecheck --workspace @filingguard/web",
    "lint:api": "node scripts/api.mjs run ruff check .",
    "test:api": "node scripts/api.mjs run pytest",
    "contracts:export": "node scripts/api.mjs run python scripts/export_openapi.py",
    "contracts:generate": "npm run contracts:generate --workspace @filingguard/web"
  }
}
